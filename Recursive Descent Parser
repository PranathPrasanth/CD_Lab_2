
#include <stdio.h>

char s[100];
int i=0,err=0;

void E();
void T();
void F();

void E()
{
    T();
    while(s[i]=='+')
    {
        i++;
        T();
    }
}

void T()
{
    F();
    while(s[i]=='*')
    {
        i++;
        F();
    }
}

void F()
{
    if(s[i]=='i')
        i++;

    else if(s[i]=='(')
    {
        i++;
        E();

        if(s[i]==')')
            i++;
        else
            err=1;
    }
    else
        err=1;
}

int main()
{
    printf("Enter expression using i: ");
    scanf("%s",s);

    E();

    if(s[i]=='\0' && !err)
        printf("Accepted");
    else
        printf("Rejected");

    return 0;
}





